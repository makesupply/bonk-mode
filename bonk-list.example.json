{
  "_readme": "Bonk Mode kill list. enabled=true means BONK 'EM ALL closes it. names = process names (no .exe). paths = wildcard match on the exe path. relaunch: omit = reopen the same exe, null = don't reopen (Windows/the app brings it back itself), or a list of {file,args}. Toggle entries from the tray menu; edit here for anything else. Protected processes (Steam, Explorer, GPU driver, security, PowerShell, Python, Windows core) are never touched no matter what this file says.",
  "apps": [
    { "label": "OneDrive", "enabled": true, "names": ["OneDrive"],
      "relaunch": [ { "file": "%LOCALAPPDATA%\\Microsoft\\OneDrive\\OneDrive.exe", "args": "/background" } ] },
    { "label": "Dropbox", "enabled": true, "names": ["Dropbox"] },
    { "label": "Google Drive", "enabled": true, "names": ["GoogleDriveFS"] },
    { "label": "Microsoft Teams", "enabled": true, "names": ["ms-teams", "msteams", "Teams"],
      "relaunch": [ { "file": "%LOCALAPPDATA%\\Microsoft\\WindowsApps\\MSTeams_8wekyb3d8bbwe\\ms-teams.exe", "args": "msteams:system-initiated" } ] },
    { "label": "Slack", "enabled": true, "names": ["slack"] },
    { "label": "Zoom", "enabled": true, "names": ["Zoom"] },
    { "label": "Adobe Creative Cloud", "enabled": true,
      "names": ["Creative Cloud", "Creative Cloud UI Helper", "Creative Cloud Helper", "Adobe Desktop Service", "CoreSync", "AdobeIPCBroker", "CCXProcess", "AdobeNotificationClient"],
      "relaunch": null },
    { "label": "Adobe Acrobat tray", "enabled": true, "names": ["AdobeCollabSync", "acrotray", "AcrobatNotificationClient"] },
    { "label": "Phone Link", "enabled": true, "names": ["PhoneExperienceHost", "YourPhoneAppProxyHost"], "relaunch": null },
    { "label": "Windows Widgets / Start feed", "enabled": true, "names": ["WidgetBoard", "WidgetService", "MicrosoftStartFeedProvider"], "relaunch": null },
    { "label": "Microsoft Edge (background)", "enabled": true, "names": ["msedge"],
      "relaunch": [ { "file": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe", "args": "--no-startup-window --win-session-start" } ] },
    { "label": "Office background helper", "enabled": true, "names": ["SDXHelper"], "relaunch": null },
    { "label": "Snipping Tool (comes back on PrtScn)", "enabled": true, "names": ["SnippingTool"], "relaunch": null },

    { "label": "Discord (voice chat)", "enabled": false, "names": ["Discord"], "paths": ["%LOCALAPPDATA%\\Discord\\*"],
      "relaunch": [ { "file": "%LOCALAPPDATA%\\Discord\\Update.exe", "args": "--processStart Discord.exe" } ] },
    { "label": "Spotify (music)", "enabled": false, "names": ["Spotify", "SpotifyLauncher"], "relaunch": [ { "file": "spotify:" } ] },
    { "label": "Google Chrome", "enabled": false, "names": ["chrome"] },
    { "label": "Firefox", "enabled": false, "names": ["firefox"] },
    { "label": "Epic Games Launcher", "enabled": false, "names": ["EpicGamesLauncher", "EpicWebHelper"] },
    { "label": "EA app", "enabled": false, "names": ["EADesktop", "EABackgroundService", "EALauncher"] },
    { "label": "Ubisoft Connect", "enabled": false, "names": ["upc", "UplayWebCore"] },
    { "label": "Battle.net", "enabled": false, "names": ["Battle.net"] },
    { "label": "Xbox app (needed for Game Pass)", "enabled": false, "names": ["XboxPcApp", "XboxPcAppFT"], "relaunch": null },
    { "label": "Corsair iCUE (lighting/macros)", "enabled": false, "names": ["iCUE"], "paths": ["*\\Corsair\\*"] },
    { "label": "Logitech G HUB (mouse DPI/profiles)", "enabled": false, "names": ["lghub_agent", "lghub_system_tray", "lghub"], "paths": ["*\\LGHUB\\*"],
      "relaunch": [ { "file": "C:\\Program Files\\LGHUB\\system_tray\\lghub_system_tray.exe", "args": "--minimized" } ] },
    { "label": "Razer Synapse", "enabled": false, "names": ["RazerAppEngine", "Razer Synapse 3", "Razer Central"] },
    { "label": "Stream Deck", "enabled": false, "names": ["StreamDeck"], "paths": ["*\\Elgato\\*"] },
    { "label": "PowerToys", "enabled": false, "names": ["PowerToys"], "paths": ["*\\PowerToys\\*"] },
    { "label": "Claude desktop", "enabled": false, "names": ["claude"], "relaunch": null }
  ]
}
